# Copy to .env and fill in. Never commit .env (rulebook §5, design rule R18).

# LLM provider: "offline" (rules + templates, no network) or "anthropic".
FEROT_LLM_PROVIDER=offline
# Only needed when FEROT_LLM_PROVIDER=anthropic. Keep it server-side.
ANTHROPIC_API_KEY=your-key-here
# Models used when the provider is "anthropic".
FEROT_LLM_EXTRACT_MODEL=claude-haiku-4-5
FEROT_LLM_DRAFT_MODEL=claude-sonnet-5-5

# Synthetic data size and seed (R16: synthetic data only).
FEROT_SEED=42
FEROT_CUSTOMERS=4000
FEROT_DAYS=90

# Where the case store (SQLite) lives.
FEROT_DB_PATH=backend/ferot.db

# Comma-separated origins allowed to call the API in development.
FEROT_CORS_ORIGINS=http://localhost:5173
